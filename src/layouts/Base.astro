---
import { Font } from "astro:assets";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { alternates, t, type Lang, type PageKey } from "@/i18n";
import "@/styles/global.css";

interface Props {
  lang: Lang;
  page: PageKey;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, page, title, description, noindex = false } = Astro.props;
const dict = t(lang);
const alt = alternates(page);
const pageTitle = title ?? dict.meta.title;
const pageDescription = description ?? dict.meta.description;
const site = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(alt[lang], site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pl" href={new URL(alt.pl, site).href} />
    <link rel="alternate" hreflang="en" href={new URL(alt.en, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(alt.pl, site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "pl" ? "pl_PL" : "en_US"} />
    <meta name="theme-color" content="#0b0d0f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline>
      (function (d) {
        d.classList.add("js");
        // Never leave content hidden: if the reveal module has not started, show everything.
        setTimeout(function () {
          if (!d.classList.contains("reveal-ready")) d.classList.add("reveal-fallback");
        }, 2500);
      })(document.documentElement);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === "pl" ? "Przejdź do treści" : "Skip to content"}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { initReveal } from "@/scripts/reveal";
      import { initSpotlight } from "@/scripts/spotlight";
      initReveal();
      initSpotlight();
    </script>
  </body>
</html>
