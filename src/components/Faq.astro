---
/**
 * FAQ accordion — one answer open at a time.
 * Progressive: without JS all answers are visible. With JS (html.js) answers start
 * collapsed and each question is a real <button> with aria-expanded / aria-controls.
 */
import SectionHead from "@/components/SectionHead.astro";
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).faq;
---

<section class="section section--surface faq" aria-labelledby="faq-title">
  <div class="container faq__inner">
    <SectionHead id="faq-title" eyebrow={d.eyebrow} title={d.title} />

    <div class="faq__list" data-faq>
      {
        d.items.map((item, i) => (
          <div class="qa" data-qa data-reveal>
            <h3 class="qa__heading">
              <button type="button" class="qa__q" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`} data-qa-toggle>
                <span class="qa__num mono">{String(i + 1).padStart(2, "0")}</span>
                <span class="qa__text">{item.q}</span>
                <span class="qa__icon" aria-hidden="true" />
              </button>
            </h3>
            <div class="qa__panel" id={`faq-a-${i}`} role="region" aria-labelledby={`faq-q-${i}`} data-qa-panel>
              <div class="qa__panel-inner">
                <p class="qa__a">{item.a}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq__list {
    border-top: 1px solid var(--color-border);
  }

  .qa {
    position: relative;
    border-bottom: 1px solid var(--color-border);
    transition: background-color 300ms var(--ease-out);
  }

  /* Expanded state: subtle raised surface + red accent on the left edge */
  .qa::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 2px;
    background: var(--color-brand-red);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 350ms var(--ease-out);
  }

  .qa.is-open {
    background: linear-gradient(90deg, rgb(255 255 255 / 0.025), transparent 70%);
  }

  .qa.is-open::before {
    transform: scaleY(1);
  }

  .qa__heading {
    font: inherit;
    margin: 0;
  }

  .qa__q {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 28px;
    gap: 1rem;
    align-items: center;
    width: 100%;
    padding: 1.4rem 0.75rem 1.4rem 1rem;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
    font-size: var(--text-md);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.35;
    color: var(--color-text);
  }

  .qa__q:focus-visible {
    outline-offset: -2px;
    border-radius: var(--radius-sm);
  }

  .qa__text {
    transition:
      color var(--dur) var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .qa__num {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  /* Hover feedback */
  .qa__q:hover .qa__text {
    transform: translateX(3px);
  }

  .qa__q:hover .qa__icon {
    border-color: var(--color-text-muted);
  }

  .qa.is-open .qa__num,
  .qa__q:hover .qa__num {
    color: var(--color-brand-red);
  }

  /* Plus → minus */
  .qa__icon {
    position: relative;
    width: 28px;
    height: 28px;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    transition:
      border-color var(--dur) var(--ease-out),
      background-color 300ms var(--ease-out),
      transform 350ms var(--ease-out);
  }

  .qa__icon::before,
  .qa__icon::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 10px;
    height: 1.5px;
    background: var(--color-text);
    transform: translate(-50%, -50%);
    transition:
      transform 350ms var(--ease-out),
      opacity 250ms var(--ease-out);
  }

  .qa__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .qa.is-open .qa__icon {
    background: var(--color-brand-red);
    border-color: var(--color-brand-red);
    transform: rotate(180deg);
  }

  .qa.is-open .qa__icon::before,
  .qa.is-open .qa__icon::after {
    background: #fff;
  }

  .qa.is-open .qa__icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
    opacity: 0;
  }

  /* Answer */
  .qa__a {
    padding: 0 3.25rem 1.6rem calc(1rem + 2.5rem + 1rem);
    color: var(--color-text-muted);
    max-width: 75ch;
    line-height: 1.65;
  }

  /* Collapsing only applies when JS is running (otherwise answers stay visible).
     Grid-rows 0fr → 1fr animates to the natural height without measuring. */
  :global(.js) .qa__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 320ms var(--ease-out),
      visibility 0s linear 320ms;
  }

  :global(.js) .qa.is-open .qa__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition:
      grid-template-rows 320ms var(--ease-out),
      visibility 0s;
  }

  .qa__panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  :global(.js) .qa__a {
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity 220ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  :global(.js) .qa.is-open .qa__a {
    opacity: 1;
    transform: none;
    transition-delay: 80ms;
  }

  @media (max-width: 559px) {
    .qa__q {
      grid-template-columns: minmax(0, 1fr) 28px;
      padding-left: 0.75rem;
      padding-right: 0.25rem;
      font-size: var(--text-base);
    }
    .qa__num {
      display: none;
    }
    .qa__a {
      padding-left: 0.75rem;
      padding-right: 0.75rem;
    }
  }

  @media (min-width: 1024px) {
    .faq__inner {
      display: grid;
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: 4rem;
      align-items: start;
    }
    .faq__inner :global(.section-head) {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-faq]").forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-qa]"));

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle("is-open", open);
      item.querySelector("[data-qa-toggle]")?.setAttribute("aria-expanded", String(open));
    };

    items.forEach((item) => {
      setOpen(item, false);
      item.querySelector("[data-qa-toggle]")?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        items.forEach((other) => other !== item && setOpen(other, false)); // one open at a time
        setOpen(item, open);
      });
    });
  });
</script>
