---
import ArrowIcon from "@/components/ArrowIcon.astro";
import { processAnchor, t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const h = d.hero;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__grid-bg" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__content">
      <p class="eyebrow hero__in" style="--i:0">{h.eyebrow}</p>
      <h1 class="h1 hero__title hero__in" id="hero-title" style="--i:1">
        <span class="hero__line">{h.titleLine1}</span>
        <span class="hero__line">
          {h.titleLine2.replace(/\.$/, "")}<span class="accent">.</span>
        </span>
      </h1>
      <p class="lead hero__lead hero__in" style="--i:2">{h.lead}</p>
      <div class="hero__actions hero__in" style="--i:3">
        <a href={d.routes.contact} class="btn btn--primary btn--block-mobile">
          {d.cta.primary}
          <ArrowIcon />
        </a>
        <a href={`#${processAnchor(lang)}`} class="btn btn--ghost btn--block-mobile">
          {h.secondary}
          <ArrowIcon direction="down" />
        </a>
      </div>
    </div>

    <figure class="schema hero__in" style="--i:4" aria-label={h.diagram.label}>
      <div class="schema__head mono">
        <span>{h.diagram.problemsLabel}</span>
        <span class="schema__head-arrow" aria-hidden="true">→</span>
        <span>{h.diagram.solutionsLabel}</span>
      </div>
      <div class="schema__body">
        <ul role="list" class="schema__col schema__col--in">
          {h.diagram.problems.map((p) => <li class="schema__chip">{p}</li>)}
        </ul>
        <div class="schema__hub" aria-hidden="true">
          <span class="schema__node"></span>
        </div>
        <ul role="list" class="schema__col schema__col--out">
          {h.diagram.solutions.map((s) => <li class="schema__chip schema__chip--solution">{s}</li>)}
        </ul>
      </div>
      <figcaption class="schema__note mono">{h.diagram.note}</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(3.5rem, 2rem + 6vw, 7.5rem);
    padding-bottom: clamp(4.5rem, 3rem + 6vw, 8.5rem);
    border-bottom: 1px solid var(--color-border-soft);
  }

  /* Faint technical grid, fading out — a detail, not a decoration. */
  .hero__grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 20%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 30%, #000 20%, transparent 75%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .hero__content {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .hero__title {
    max-width: 13ch;
  }

  .hero__line {
    display: block;
  }

  .hero__line + .hero__line {
    color: var(--color-text-muted);
  }

  .hero__lead {
    max-width: 52ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  /* Entrance: subtle and fast, never blocks reading. */
  .hero__in {
    animation: hero-in 800ms var(--ease-out) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* Schema: problem → hub → solution */
  .schema {
    align-self: center;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, var(--color-surface) 0%, rgb(18 22 25 / 0.6) 100%);
    padding: clamp(1rem, 0.6rem + 1.5vw, 1.5rem);
    max-width: 560px;
    width: 100%;
  }

  .schema__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    padding-bottom: 1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px dashed var(--color-border);
  }

  .schema__head-arrow {
    color: var(--color-brand-red);
  }

  .schema__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 44px minmax(0, 1fr);
    align-items: center;
  }

  .schema__col {
    display: grid;
    gap: 0.6rem;
    position: relative;
  }

  .schema__chip {
    position: relative;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    font-size: clamp(0.75rem, 0.7rem + 0.2vw, 0.875rem);
    line-height: 1.3;
    color: var(--color-text);
  }

  /* Horizontal connectors toward the hub */
  .schema__col--in .schema__chip::after,
  .schema__col--out .schema__chip::before {
    content: "";
    position: absolute;
    top: 50%;
    width: 22px;
    height: 1px;
    background: var(--color-border);
  }
  .schema__col--in .schema__chip::after {
    left: 100%;
  }
  .schema__col--out .schema__chip::before {
    right: 100%;
  }

  /* Vertical bus lines */
  .schema__col--in::after,
  .schema__col--out::before {
    content: "";
    position: absolute;
    top: 1.3rem;
    bottom: 1.3rem;
    width: 1px;
    background: var(--color-border);
  }
  .schema__col--in::after {
    right: -22px;
  }
  .schema__col--out::before {
    left: -22px;
  }

  .schema__hub {
    display: grid;
    place-items: center;
    height: 100%;
    position: relative;
  }

  .schema__hub::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--color-brand-red);
  }

  .schema__node {
    position: relative;
    width: 12px;
    height: 12px;
    background: var(--color-brand-red);
    box-shadow: 0 0 0 5px var(--color-surface);
  }

  .schema__chip--solution {
    font-weight: 500;
    animation: chip-active 8s var(--ease-out) infinite;
  }
  .schema__chip--solution:nth-child(2) {
    animation-delay: 2s;
  }
  .schema__chip--solution:nth-child(3) {
    animation-delay: 4s;
  }
  .schema__chip--solution:nth-child(4) {
    animation-delay: 6s;
  }

  @keyframes chip-active {
    0%,
    30%,
    100% {
      border-color: var(--color-border);
      color: var(--color-text);
    }
    6%,
    22% {
      border-color: var(--color-brand-teal);
      color: var(--color-teal-text);
    }
  }

  .schema__note {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
      align-items: center;
    }
    .schema {
      justify-self: end;
    }
  }
</style>
