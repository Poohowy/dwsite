---
import { alternates, processAnchor, t, type Lang, type PageKey } from "@/i18n";

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
const d = t(lang);
const alt = alternates(page);
const current = Astro.url.pathname;

const links = [
  { href: d.routes.pricer, label: d.nav.pricer },
  { href: d.routes.archiflow, label: d.nav.archiflow },
  { href: `${d.routes.home}#${processAnchor(lang)}`, label: d.nav.process },
];
const isCurrent = (href: string) => current === href;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={d.routes.home} class="site-header__logo" aria-label={d.nav.homeLabel}>
      <img src="/images/data-wildcat-logo.svg" alt="Data Wildcat" width="415" height="106" />
    </a>

    <nav class="site-nav" aria-label={d.nav.label}>
      <ul role="list" class="site-nav__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? "page" : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <div class="lang-switch" role="group" aria-label={d.nav.langLabel}>
        <a href={alt.pl} hreflang="pl" lang="pl" aria-current={lang === "pl" ? "true" : undefined}>PL</a>
        <span aria-hidden="true">/</span>
        <a href={alt.en} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
      </div>
      <a href={d.routes.contact} class="btn btn--primary btn--sm site-header__cta">{d.nav.cta}</a>
      <button
        type="button"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={d.nav.menuOpen}
        data-label-close={d.nav.menuClose}
      >
        <span class="visually-hidden" data-menu-label>{d.nav.menuOpen}</span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
        <span class="menu-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label={d.nav.label}>
      <ul role="list" class="mobile-menu__links">
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-menu-link>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-menu__footer">
        <div class="lang-switch" role="group" aria-label={d.nav.langLabel}>
          <a href={alt.pl} hreflang="pl" lang="pl" aria-current={lang === "pl" ? "true" : undefined}>PL</a>
          <span aria-hidden="true">/</span>
          <a href={alt.en} hreflang="en" lang="en" aria-current={lang === "en" ? "true" : undefined}>EN</a>
        </div>
        <a href={d.routes.contact} class="btn btn--primary btn--block-mobile">{d.cta.primary}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  .site-header[data-scrolled],
  .site-header[data-open] {
    background: rgb(11 13 15 / 0.88);
    border-bottom-color: var(--color-border-soft);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--header-h);
  }

  .site-header__logo {
    flex: none;
    display: block;
  }

  .site-header__logo img {
    height: 30px;
    width: auto;
  }

  .site-nav {
    display: none;
  }

  .site-nav__links {
    display: flex;
    gap: 2rem;
  }

  .site-nav__links a,
  .lang-switch a {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition: color var(--dur) var(--ease-out);
  }

  .site-nav__links a:hover,
  .site-nav__links a[aria-current="page"],
  .lang-switch a:hover,
  .lang-switch a[aria-current="true"] {
    color: var(--color-text);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .site-header__actions > .lang-switch,
  .site-header__cta {
    display: none;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono-stack);
    font-size: var(--text-xs);
    color: var(--color-border);
  }

  .lang-switch a {
    font-size: var(--text-xs);
    padding: 0.5rem 0.15rem;
  }

  .lang-switch a[aria-current="true"] {
    box-shadow: inset 0 -1px 0 var(--color-brand-red);
  }

  /* Mobile menu toggle */
  .menu-toggle {
    display: inline-grid;
    place-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .menu-toggle__bar {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform var(--dur) var(--ease-out);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:first-of-type {
    transform: translateY(3.75px) rotate(45deg);
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle__bar:last-of-type {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile-menu {
    border-top: 1px solid var(--color-border-soft);
    background: var(--color-bg);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .mobile-menu__links {
    padding-block: 1.5rem;
  }

  .mobile-menu__links a {
    display: block;
    padding: 1rem 0;
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .mobile-menu__footer {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 2rem;
  }

  @media (min-width: 900px) {
    .site-nav,
    .site-header__actions > .lang-switch,
    .site-header__cta {
      display: flex;
    }
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
    }
    .site-header__actions {
      justify-content: flex-end;
    }
    .menu-toggle,
    .mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const menu = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const label = document.querySelector<HTMLElement>("[data-menu-label]");

  if (header) {
    const onScroll = () => header.toggleAttribute("data-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  if (header && toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute("aria-expanded", String(open));
      label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? "";
      menu.hidden = !open;
      header.toggleAttribute("data-open", open);
      document.body.style.overflow = open ? "hidden" : "";
    };

    toggle.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"));
    menu.querySelectorAll("[data-menu-link]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia("(min-width: 900px)").addEventListener("change", (e) => e.matches && setOpen(false));
  }
</script>
