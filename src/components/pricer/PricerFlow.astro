---
/**
 * Hero visual: customer message → products & prices → quote → ready offer.
 * Deliberately abstract (skeleton lines, no figures) — an illustration of the
 * flow, not a screenshot of a running system.
 */
import type { PricerCopy } from "@/i18n/pricer";

interface Props {
  flow: PricerCopy["hero"]["flow"];
}
const { flow } = Astro.props;
---

<figure class="pf" aria-label={flow.label}>
  <ol class="pf__list" role="list">
    <!-- 1. Message -->
    <li class="pf__node pf__node--message" style="--n:0">
      <span class="pf__step mono">01</span>
      <div class="pf__card">
        <div class="pf__head">
          <span class="pf__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="5" width="18" height="14" rx="1.5"></rect><path d="m3.5 6 8.5 7 8.5-7"></path>
            </svg>
          </span>
          <span class="pf__title">{flow.message}</span>
        </div>
        <span class="sk" style="width:86%"></span>
        <span class="sk-row"><span class="sk" style="width:34%"></span><span class="mark"></span><span class="sk" style="width:20%"></span></span>
        <span class="sk-row"><span class="mark mark--b"></span><span class="sk" style="width:40%"></span></span>
      </div>
    </li>

    <!-- 2. Products & prices -->
    <li class="pf__node pf__node--catalogue" style="--n:1">
      <span class="pf__step mono">02</span>
      <div class="pf__card">
        <div class="pf__head">
          <span class="pf__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3.5" y="4" width="17" height="16" rx="1.5"></rect><path d="M3.5 9h17M3.5 14h17M10 4v16"></path>
            </svg>
          </span>
          <span class="pf__title">{flow.catalogue}</span>
        </div>
        <div class="pf__table">
          {
            [62, 48, 70].map((w, i) => (
              <div class:list={["pf__row", { "pf__row--hit": i !== 1 }]}>
                <span class="sk" style={`width:${w}%`} />
                <span class="pf__chip mono">{flow.vat}</span>
                <span class="sk sk--num" />
              </div>
            ))
          }
        </div>
      </div>
    </li>

    <!-- 3. Quote -->
    <li class="pf__node pf__node--quote" style="--n:2">
      <span class="pf__step mono">03</span>
      <div class="pf__card">
        <div class="pf__head">
          <span class="pf__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="5" y="3" width="14" height="18" rx="1.5"></rect><path d="M8.5 7.5h7M8.5 11h2M13.5 11h2M8.5 14.5h2M13.5 14.5h2M8.5 18h7"></path>
            </svg>
          </span>
          <span class="pf__title">{flow.quote}</span>
        </div>
        <div class="pf__sum">
          <span class="sk" style="width:36%"></span><span class="sk sk--num"></span>
          <span class="sk" style="width:22%"></span><span class="sk sk--num"></span>
          <span class="sk sk--strong" style="width:30%"></span><span class="sk sk--num sk--strong"></span>
        </div>
      </div>
    </li>

    <!-- 4. Offer -->
    <li class="pf__node pf__node--offer" style="--n:3">
      <span class="pf__step mono">04</span>
      <div class="pf__card pf__card--paper">
        <div class="pf__head">
          <span class="pf__logo" aria-hidden="true"></span>
          <span class="pf__title">{flow.offer}</span>
          <span class="pf__formats mono"><b>HTML</b><b>PDF</b></span>
        </div>
        <span class="sk" style="width:70%"></span>
        <span class="sk" style="width:54%"></span>
        <span class="sk sk--strong" style="width:28%; margin-left:auto"></span>
      </div>
    </li>
  </ol>
</figure>

<style>
  .pf {
    position: relative;
    max-width: 520px;
    width: 100%;
    justify-self: center;
  }

  .pf::before {
    content: "";
    position: absolute;
    inset: 10% 0 0;
    background: radial-gradient(ellipse at 60% 50%, rgb(31 140 165 / 0.16), transparent 65%);
    filter: blur(30px);
    z-index: 0;
  }

  .pf__list {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.1rem;
  }

  .pf__node {
    position: relative;
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: start;
    animation: pf-in 700ms var(--ease-reveal) both;
    animation-delay: calc(400ms + var(--n) * 120ms);
  }

  @keyframes pf-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* Connector between steps, with a small travelling light */
  .pf__node:not(:last-child)::before {
    content: "";
    position: absolute;
    left: calc(1rem - 0.5px);
    top: 1.6rem;
    bottom: -1.1rem;
    width: 1px;
    background: linear-gradient(var(--color-border), var(--color-border));
  }

  .pf__node:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(1rem - 2.5px);
    top: 1.6rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-teal-text);
    opacity: 0;
    animation: pf-travel 4.8s ease-in-out infinite;
    animation-delay: calc(1.4s + var(--n) * 1.2s);
  }

  /* Travels the full connector (node height + gap); tiny absolutely positioned dot */
  @keyframes pf-travel {
    0% {
      top: 1.6rem;
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
    22% {
      top: calc(100% + 1.1rem);
      opacity: 0;
    }
    100% {
      top: calc(100% + 1.1rem);
      opacity: 0;
    }
  }

  .pf__step {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-bg);
    font-size: 0.625rem;
    color: var(--color-text-muted);
  }

  .pf__node--offer .pf__step {
    border-color: var(--color-brand-red);
    color: var(--color-text);
  }

  .pf__card {
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: linear-gradient(180deg, #181e22, #13181b);
    box-shadow: 0 18px 40px -26px rgb(0 0 0 / 0.9);
  }

  /* Gentle zig-zag on wider screens for depth */
  @media (min-width: 560px) {
    .pf__node--catalogue .pf__card,
    .pf__node--offer .pf__card {
      margin-left: 2.25rem;
    }
  }

  .pf__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.2rem;
  }

  .pf__icon {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: rgb(31 140 165 / 0.14);
    color: var(--color-teal-text);
  }

  .pf__icon svg {
    width: 15px;
    height: 15px;
  }

  .pf__title {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }

  .sk {
    display: block;
    height: 6px;
    border-radius: 3px;
    background: #343c41;
    flex: none;
  }

  .sk--num {
    width: 16%;
    margin-left: auto;
  }

  .sk--strong {
    background: #6b767b;
  }

  .sk-row {
    display: flex;
    gap: 5px;
    align-items: center;
  }

  .mark {
    display: block;
    width: 24%;
    height: 10px;
    border-radius: 3px;
    background: rgb(31 140 165 / 0.28);
    box-shadow: inset 0 0 0 1px rgb(79 179 203 / 0.6);
  }

  .mark--b {
    width: 30%;
  }

  .pf__table {
    display: grid;
    gap: 0.35rem;
  }

  .pf__row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.45rem;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.02);
  }

  .pf__row--hit {
    box-shadow: inset 2px 0 0 var(--color-brand-teal);
    background: rgb(31 140 165 / 0.07);
  }

  .pf__chip {
    font-size: 0.5625rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--color-border);
    border-radius: 3px;
    color: var(--color-text-muted);
  }

  .pf__sum {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem 1rem;
    align-items: center;
  }

  .pf__sum .sk--num {
    width: 46px;
  }

  .pf__sum > :nth-last-child(-n + 2) {
    margin-top: 0.3rem;
  }

  /* Offer: light paper */
  .pf__card--paper {
    background: #f7f7f5;
    border-color: transparent;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.05),
      0 24px 50px -24px rgb(0 0 0 / 0.9);
  }

  .pf__card--paper .pf__title {
    color: var(--color-light-text);
  }

  .pf__card--paper .sk {
    background: #dcdfdc;
  }

  .pf__card--paper .sk--strong {
    background: var(--color-light-text);
  }

  .pf__logo {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--color-brand-red) 50%, var(--color-brand-teal) 50%);
  }

  .pf__formats {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }

  .pf__formats b {
    font-weight: 500;
    font-size: 0.5625rem;
    padding: 0.1rem 0.35rem;
    border-radius: 3px;
    background: var(--color-light-text);
    color: var(--color-light-bg);
  }

  .pf__formats b + b {
    background: var(--color-brand-red);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .pf__node:not(:last-child)::after {
      display: none;
    }
  }
</style>
