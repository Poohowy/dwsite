---
/**
 * Hero background: faint technical grid + interactive dot field (Canvas).
 * The CSS dot pattern is the static fallback (no JS / no canvas); it is hidden
 * once the canvas has rendered. Must be placed inside a positioned host.
 */
---

<div class="hero-bg" aria-hidden="true">
  <div class="hero-bg__grid"></div>
  <div class="hero-bg__dots"></div>
  <canvas class="hero-bg__canvas" data-hero-particles></canvas>
  <div class="hero-bg__light"></div>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-bg__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.03) 1px, transparent 1px);
    background-size: 104px 104px;
    background-position: center top;
    mask-image: radial-gradient(ellipse 75% 70% at 72% 35%, #000 15%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 75% 70% at 72% 35%, #000 15%, transparent 75%);
  }

  /* Static fallback dot field */
  .hero-bg__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(196 202 205 / 0.13) 1px, transparent 1.3px);
    background-size: 24px 24px;
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.3) 15%, #000 70%), linear-gradient(#000 75%, transparent);
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.3) 15%, #000 70%);
    transition: opacity 600ms var(--ease-out);
  }

  .hero-bg__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 400ms var(--ease-out);
  }

  .hero-bg[data-ready] .hero-bg__canvas {
    opacity: 1;
  }

  .hero-bg[data-ready] .hero-bg__dots {
    opacity: 0;
  }

  /* Very soft directional light, gives depth without glow */
  .hero-bg__light {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 60% at 85% 10%, rgb(31 140 165 / 0.08), transparent 70%),
      radial-gradient(ellipse 35% 40% at 95% 85%, rgb(228 0 58 / 0.04), transparent 70%);
  }
</style>

<script>
  import { initParticles } from "@/scripts/particles";

  document.querySelectorAll<HTMLCanvasElement>("[data-hero-particles]").forEach((canvas) => {
    const bg = canvas.parentElement;
    const host = bg?.parentElement;
    if (!bg || !host) return;
    try {
      initParticles({ canvas, host });
      bg.setAttribute("data-ready", "");
    } catch {
      // Keep the static CSS fallback.
    }
  });
</script>
