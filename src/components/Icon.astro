---
// Minimal geometric line icons drawn for this site (24×24 grid, 1.5px stroke).
import type { IconName } from "@/lib/icons";

interface Props {
  name: IconName;
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  aria-hidden="true"
>
  {
    name === "automation" && (
      <>
        <path d="M4 12a8 8 0 0 1 13.7-5.6M20 12a8 8 0 0 1-13.7 5.6" />
        <path d="M18 2.5v4h-4M6 21.5v-4h4" />
      </>
    )
  }
  {
    name === "ai" && (
      <>
        <rect x="6" y="6" width="12" height="12" />
        <path d="M9.5 3v3M14.5 3v3M9.5 18v3M14.5 18v3M3 9.5h3M3 14.5h3M18 9.5h3M18 14.5h3" />
        <path d="M10 10h4v4h-4z" />
      </>
    )
  }
  {
    name === "app" && (
      <>
        <rect x="3" y="4" width="18" height="16" />
        <path d="M3 8.5h18M8 8.5V20" />
      </>
    )
  }
  {
    name === "integration" && (
      <>
        <rect x="2.5" y="8.5" width="7" height="7" />
        <rect x="14.5" y="8.5" width="7" height="7" />
        <path d="M9.5 12h5" />
      </>
    )
  }
  {
    name === "cloud" && <path d="M7 19h10.5a4.5 4.5 0 0 0 .6-8.96A6 6 0 0 0 6.6 9.1 5 5 0 0 0 7 19Z" />
  }
  {
    name === "server" && (
      <>
        <rect x="3.5" y="4" width="17" height="7" />
        <rect x="3.5" y="13" width="17" height="7" />
        <path d="M7 7.5h2M7 16.5h2" />
      </>
    )
  }
  {
    name === "flow" && (
      <>
        <circle cx="5" cy="6" r="2.5" />
        <circle cx="19" cy="18" r="2.5" />
        <path d="M7.5 6H14a3 3 0 0 1 3 3v6.5" />
        <path d="M5 8.5V15a3 3 0 0 0 3 3h8.5" />
      </>
    )
  }
  {
    name === "blocks" && (
      <>
        <rect x="3.5" y="3.5" width="7" height="7" />
        <rect x="13.5" y="3.5" width="7" height="7" />
        <rect x="3.5" y="13.5" width="7" height="7" />
        <path d="M17 13.5v7M13.5 17h7" />
      </>
    )
  }
</svg>
