---
import ArrowIcon from "@/components/ArrowIcon.astro";
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const dict = t(Astro.props.lang);
const d = dict.finalCta;
---

<section class="section light final" aria-labelledby="final-title">
  <div class="container final__inner">
    <h2 class="final__title" id="final-title" data-reveal>{d.title}</h2>
    <div class="final__side" data-reveal>
      <p class="lead">{d.text}</p>
      <a href={dict.routes.contact} class="btn btn--primary btn--block-mobile">
        {dict.cta.primary}
        <ArrowIcon />
      </a>
    </div>
  </div>
</section>

<style>
  .final__inner {
    display: grid;
    gap: 2.5rem;
  }

  .final__title {
    font-size: clamp(2.4rem, 1.4rem + 4.4vw, 5.5rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.98;
    max-width: 15ch;
    text-wrap: balance;
  }

  .final__side {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    align-content: end;
    max-width: 44ch;
  }

  @media (min-width: 1024px) {
    .final__inner {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      align-items: end;
      gap: 4rem;
    }
  }
</style>
