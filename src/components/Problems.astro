---
import SectionHead from "@/components/SectionHead.astro";
import { t, type Lang } from "@/i18n";

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).problems;
---

<section class="section section--surface problems" aria-labelledby="problems-title">
  <div class="container">
    <SectionHead id="problems-title" eyebrow={d.eyebrow} title={d.title} intro={d.intro} layout="columns" size="lg" />
    <ol role="list" class="problems__grid">
      {
        d.items.map((item, i) => (
          <li class="problem" data-reveal data-spotlight>
            <span class="problem__num mono">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="h3 problem__title">{item.title}</h3>
            <p class="problem__text">{item.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .problems__grid {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .problem {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
    transition: background-color var(--dur) var(--ease-out);
  }

  .problem::before {
    content: "";
    position: absolute;
    left: -1px;
    top: -1px;
    width: 0;
    height: 2px;
    background: var(--color-brand-red);
    transition: width 400ms var(--ease-out);
  }

  .problem:hover {
    background: var(--color-surface-raised);
  }

  .problem:hover::before {
    width: calc(100% + 1px);
  }

  .problem__num {
    font-size: var(--text-xs);
    color: var(--color-teal-text);
    letter-spacing: 0.06em;
    margin-bottom: clamp(0.5rem, 0.2rem + 1.5vw, 2rem);
  }

  .problem__text {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  @media (min-width: 640px) {
    .problems__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .problems__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* Grid breaks slightly out of the content column for a wider, more open composition */
    .problems__grid {
      margin-inline: calc(var(--gutter) * -0.5);
    }
    .problem {
      min-height: 280px;
    }
  }
</style>
