---
import Icon from "@/components/Icon.astro";
import SectionHead from "@/components/SectionHead.astro";
import { t, type Lang } from "@/i18n";
import type { IconName } from "@/lib/icons";

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).capabilities;
const icons: IconName[] = ["cloud", "server", "flow", "blocks"];
---

<section class="section light capabilities" aria-labelledby="capabilities-title">
  <div class="container cap__layout">
    <SectionHead id="capabilities-title" eyebrow={d.eyebrow} title={d.title} intro={d.intro} />

    <ul role="list" class="cap__grid">
      {
        d.items.map((item, i) => (
          <li class="cap" data-reveal>
            <Icon name={icons[i]} class="cap__icon" />
            <div class="cap__body">
              <h3 class="h3">{item.title}</h3>
              <p class="muted">{item.text}</p>
              {item.tags && (
                <ul role="list" class="cap__tags">
                  {item.tags.map((tag) => (
                    <li class="mono">{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cap__grid {
    display: grid;
    border-top: 1px solid var(--color-light-border);
  }

  .cap {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 1.25rem;
    padding-block: clamp(1.75rem, 1.4rem + 1.2vw, 2.5rem);
    border-bottom: 1px solid var(--color-light-border);
  }

  .cap :global(.cap__icon) {
    width: 32px;
    height: 32px;
    color: var(--color-brand-teal);
  }

  .cap__body {
    display: grid;
    gap: 0.6rem;
    max-width: 48ch;
  }

  .cap__body p {
    font-size: 0.9375rem;
  }

  .cap__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .cap__tags li {
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--color-light-border);
    border-radius: 3px;
    color: var(--color-light-muted);
  }

  .cap__body {
    transition: transform 400ms var(--ease-out);
  }

  .cap:hover .cap__body {
    transform: translateX(6px);
  }

  .cap:hover :global(.cap__icon) {
    color: var(--color-brand-red);
  }

  .cap :global(.cap__icon) {
    transition: color 300ms var(--ease-out);
  }

  @media (min-width: 1024px) {
    .cap__layout {
      display: grid;
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
      gap: clamp(3rem, 1rem + 5vw, 7rem);
      align-items: start;
    }
    .cap__layout :global(.section-head) {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
      margin-bottom: 0;
    }
    .cap {
      grid-template-columns: 56px minmax(0, 1fr);
    }
  }
</style>
